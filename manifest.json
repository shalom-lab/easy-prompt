{
  "manifest_version": 3,
  "name": "Easy Prompt",
  "version": "1.0.0",
  "description": "Save and reuse your awesome prompts for ChatGPT, Claude, Gemini, DeepSeek and other AI chat assistants. Boost your AI conversation efficiency with quick prompt insertion.",
  "author": "your_name",
  "homepage_url": "https://github.com/yourusername/easy-prompt",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "notifications",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
