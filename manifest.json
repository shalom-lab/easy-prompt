{
  "manifest_version": 3,
  "name": "Prompt Saver",
  "version": "1.0",
  "description": "Save, manage, and copy your favorite prompts quickly.",
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "clipboardRead"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
